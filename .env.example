DB_USER=shopuser
DB_PASSWORD=change_me_in_env
DB_NAME=shopsmart
# Long random value, e.g. from:  openssl rand -base64 48
JWT_SECRET=
# Admin account. Leave ADMIN_PASSWORD empty and run `npm run admin:password`
# on the server to generate one. Never commit a real password.
ADMIN_EMAIL=admin@shopsmart.com
ADMIN_PASSWORD=
# Password for the synthetic shopper accounts the traffic generator signs in
# with (any long random value, e.g. openssl rand -base64 24). Without it the
# bots only browse and never buy.
SYNTHETIC_BOT_PASSWORD=
